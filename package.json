{
  "name": "ideologynormativesorter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reportsDirectory=coverage",
    "test:e2e": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "test:ecw": "playwright test --project=ecw",
    "test:browser": "playwright test",
    "research:check": "node scripts/check-research-contract.mjs",
    "canonical:migrate": "node scripts/migrate-canonical-manifest.mjs",
    "canonical:check": "node scripts/check-canonical-imports.mjs --check",
    "reference-lock:replay": "node scripts/replay-reference-lock.mjs --baseline docs/clean-rebuild/reference-lock --actual artifacts/reference-lock/current",
    "reference-lock:diff": "node scripts/compare-reference-lock.mjs --baseline docs/clean-rebuild/reference-lock --actual artifacts/reference-lock/current",
    "test:worker": "node --test research-worker/worker.test.mjs",
    "analysis:smoke": "bash scripts/run-r-smoke.sh",
    "v2:reference:verify": "node scripts/v2-reference/verify-reference.mjs",
    "v2:reference:differential": "node scripts/v2-reference/differential.mjs",
    "v2:reference:coverage": "node scripts/v2-reference/coverage.mjs",
    "v2:reference:hash": "node scripts/v2-reference/hash.mjs",
    "v2:reference:report": "node scripts/v2-reference/report.mjs",
    "v2:web:dev": "vite --config v2/apps/web/vite.config.ts --mode v2",
    "v2:web:dev:test": "vite --config v2/apps/web/vite.config.ts --mode test",
    "v2:web:typecheck": "tsc -p v2/apps/web/tsconfig.json --noEmit",
    "v2:web:build": "npm run v2:web:typecheck && vite build --config v2/apps/web/vite.config.ts --mode v2",
    "v2:web:test": "vitest run tests/view-model/v2-phase11-view-model.test.ts tests/v2-web tests/architecture/v2-phase11-web.test.ts",
    "v2:web:test:e2e": "playwright test --config playwright.v2.config.ts",
    "v2:web:test:a11y": "playwright test --config playwright.v2.config.ts --grep @a11y",
    "v2:web:test:visual": "playwright test --config playwright.v2.config.ts --grep @visual",
    "v2:web:performance": "node v2/tools/measure-web-performance.mjs",
    "v2:persistence:typecheck": "tsc -p v2/packages/persistence/tsconfig.json --noEmit",
    "v2:persistence:test": "vitest run tests/persistence/v2-phase12-persistence.test.ts tests/architecture/v2-phase12-persistence.test.ts",
    "v2:persistence:size": "node v2/tools/measure-persistence-size.mjs",
    "v2:research:acceptance": "node v2/tools/generate-research-acceptance.mjs",
    "v2:research:typecheck": "tsc -p v2/packages/research/tsconfig.json --noEmit",
    "v2:research:test": "vitest run tests/research/v2-phase13-research.test.ts tests/architecture/v2-phase13-research.test.ts",
    "v2:research:worker:test": "node --test v2/research-worker/tests/worker.node.mjs",
    "v2:research:d1": "node v2/tools/run-local-research-integration.mjs",
    "v2:research:performance": "node v2/tools/measure-research-performance.mjs",
    "v2:research:readiness": "node v2/tools/generate-research-readiness.mjs",
    "worker:check": "wrangler deploy --dry-run --config research-worker/wrangler.jsonc",
    "worker:migrate": "wrangler d1 migrations apply political-judgment-contributions --remote --config research-worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config research-worker/wrangler.jsonc"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "wrangler": "4.120.1"
  }
}
