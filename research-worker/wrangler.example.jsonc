{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // EXAMPLE ONLY. This file is non-production and intentionally sentinel-gated.
  // Replace values only with owner-approved non-production resources and metadata.
  // Never copy a production origin, route, endpoint, resource ID, or secret here.
  // Do not deploy while any REPLACE_WITH_* sentinel remains.
  "name": "political-judgment-contributions-example",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "example",
    "ALLOWED_ORIGIN": "REPLACE_WITH_NON_PRODUCTION_PAGES_ORIGIN",
    "EXPECTED_STUDY_ID": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_STUDY_ID",
    "EXPECTED_SCHEMA_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_SCHEMA_VERSION",
    "EXPECTED_CONSENT_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_CONSENT_VERSION",
    "EXPECTED_QUALITY_RULE_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_QUALITY_RULE_VERSION",
    "EXPECTED_FORM_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_FORM_VERSION",
    "EXPECTED_BANK_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_BANK_VERSION",
    "EXPECTED_SCORING_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_SCORING_VERSION",
    "EXPECTED_TAXONOMY_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_TAXONOMY_VERSION",
    "EXPECTED_PRIMARY_MEASUREMENT_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_PRIMARY_MEASUREMENT_VERSION",
    "EXPECTED_MODIFIER_MEASUREMENT_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_MODIFIER_MEASUREMENT_VERSION",
    "EXPECTED_PRIMARY_LABEL_ROSTER_FINGERPRINT": "REPLACE_WITH_GENERATED_PRIMARY_LABEL_ROSTER_FINGERPRINT",
    "EXPECTED_MODIFIER_LABEL_ROSTER_FINGERPRINT": "REPLACE_WITH_GENERATED_MODIFIER_LABEL_ROSTER_FINGERPRINT",
    "EXPECTED_SPECIALIST_ASSIGNMENT_STRATEGY": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_ASSIGNMENT_STRATEGY",
    "EXPECTED_SPECIALIST_ASSIGNMENT_ROSTER_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_SPECIALIST_ROSTER_VERSION",
    "EXPECTED_SPECIALIST_ASSIGNMENT_MODULE_IDS": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_SPECIALIST_MODULE_IDS",
    "EXPECTED_CONTRACT_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_CONTRACT_VERSION",
    "EXPECTED_SOURCE_MANIFEST_SHA256": "REPLACE_WITH_GENERATED_SOURCE_MANIFEST_SHA256",
    "EXPECTED_MANIFEST_SCHEMA_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_MANIFEST_SCHEMA_VERSION",
    "EXPECTED_MANIFEST_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_MANIFEST_VERSION",
    "EXPECTED_MANIFEST_FINGERPRINT": "REPLACE_WITH_GENERATED_MANIFEST_FINGERPRINT",
    "EXPECTED_SERIALIZATION_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_SERIALIZATION_VERSION",
    "EXPECTED_SERIALIZATION_FINGERPRINT": "REPLACE_WITH_GENERATED_SERIALIZATION_FINGERPRINT",
    "EXPECTED_CONTRACT_SCHEMA_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_CONTRACT_SCHEMA_VERSION",
    "EXPECTED_SCHEMA_FINGERPRINT": "REPLACE_WITH_GENERATED_SCHEMA_FINGERPRINT",
    "EXPECTED_CONTRACT_ROUTE": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_CONTRACT_ROUTE",
    "EXPECTED_COHORT": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_COHORT",
    "EXPECTED_COHORT_VERSION": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_COHORT_VERSION",
    "EXPECTED_COHORT_FINGERPRINT": "REPLACE_WITH_GENERATED_COHORT_FINGERPRINT",
    "ALLOWED_LEGACY_CONTRACT_ROUTES": "",
    "EXPECTED_MODERATE_ITEM_COUNT": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_MODERATE_ITEM_COUNT",
    "EXPECTED_EXTENSIVE_ITEM_COUNT": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_EXTENSIVE_ITEM_COUNT",
    "ALLOWED_LEGACY_MODERATE_ITEM_COUNTS": "",
    "ALLOWED_LEGACY_EXTENSIVE_ITEM_COUNTS": "",
    "ALLOWED_MATRIX_ITEM_COUNTS": "REPLACE_WITH_OWNER_APPROVED_NON_PRODUCTION_MATRIX_ITEM_COUNTS",
    "MAXIMUM_BODY_BYTES": "2000000",
    // These controls are intentionally unresolved and are not secrets.
    // The Worker must fail closed until release/infra records the audited mode,
    // grace window, and owner approval for this non-production environment.
    "WRITE_MODE": "REPLACE_WITH_RELEASE_INFRA_APPROVED_WRITE_MODE__drain_or_open",
    "WRITE_MODE_GRACE_SECONDS": "REPLACE_WITH_RELEASE_INFRA_APPROVED_WRITE_MODE_GRACE_SECONDS",
    "ACTIVE_SESSION_GRACE_DAYS": "REPLACE_WITH_RELEASE_INFRA_APPROVED_ACTIVE_SESSION_GRACE_DAYS__14_DEFAULT_MAX_30",
    "ACTIVE_SESSION_GRACE_END": "REPLACE_WITH_RELEASE_INFRA_APPROVED_ACTIVE_SESSION_GRACE_END_ISO8601",
    "EXAMPLE_OWNER_APPROVAL": "REPLACE_WITH_RELEASE_INFRA_OWNER_APPROVAL_REFERENCE",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_D1_DATABASE_NAME",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RESEARCH_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_RATE_LIMITER_NAMESPACE_ID",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
