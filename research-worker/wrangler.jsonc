{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "political-judgment-contributions",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-10",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGIN": "https://ideologynormativesorter.edriffles.us",
    "EXPECTED_STUDY_ID": "community-2026",
    "EXPECTED_SCHEMA_VERSION": "2026-08-v5",
    "EXPECTED_CONSENT_VERSION": "2026-08-10-v6",
    "EXPECTED_QUALITY_RULE_VERSION": "data-quality-v2",
    "EXPECTED_FORM_VERSION": "profile-form-v3",
    "EXPECTED_MODERATE_ITEM_COUNT": "140",
    "EXPECTED_EXTENSIVE_ITEM_COUNT": "285",
    "ALLOWED_LEGACY_MODERATE_ITEM_COUNTS": "158,149",
    "ALLOWED_LEGACY_EXTENSIVE_ITEM_COUNTS": "336,309",
    "ALLOWED_MATRIX_ITEM_COUNTS": "120",
    "MAXIMUM_BODY_BYTES": "2000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "political-judgment-contributions",
      "database_id": "5681f1c3-960b-4872-b0ea-396a590d3708",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RESEARCH_RATE_LIMITER",
      "namespace_id": "24001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
