{
  "$id": "https://example.com/v2/specialist-module.schema.json",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "shortTitle",
    "description",
    "invitationNote",
    "estimatedMinutes",
    "activation",
    "itemIds",
    "constructIds",
    "candidateIds",
    "outputProfileIds"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "shortTitle": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "invitationNote": { "type": "string", "minLength": 1 },
    "estimatedMinutes": { "type": "number", "minimum": 0 },
    "activation": {
      "type": "object",
      "required": [
        "strategy",
        "minimumAnsweredItems",
        "minimumAnsweredWeightRatio",
        "minimumConstructCoverageRatio"
      ],
      "properties": {
        "strategy": { "const": "explicit-request" },
        "minimumAnsweredItems": { "type": "integer", "minimum": 0 },
        "minimumAnsweredWeightRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimumConstructCoverageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "itemIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "constructIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "candidateIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputProfileIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenanceRefs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
