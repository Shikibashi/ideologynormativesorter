{
  "$id": "https://example.com/v2/construct.schema.json",
  "type": "object",
  "required": ["id", "name", "role", "scope"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "role": { "enum": ["normative", "descriptive", "prescriptive", "specialist"] },
    "scope": { "enum": ["root", "specialist"] },
    "domainId": { "type": "string", "minLength": 1 },
    "moduleId": { "type": "string", "minLength": 1 },
    "family": { "type": "string" },
    "description": { "type": "string" },
    "canonicalDefinition": { "type": "string", "minLength": 1 },
    "conceptualScope": { "type": "string", "minLength": 1 },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "boundaryCases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "semanticLayer": { "enum": ["normative", "descriptive", "prescriptive", "mixed"] },
    "structureType": { "enum": ["bipolar", "unipolar", "multidimensional", "conditional"] },
    "boundaryStatement": { "type": "string" },
    "sourceKey": { "type": "string" },
    "poles": {
      "type": "object",
      "properties": {
        "negative": { "type": "string" },
        "positive": { "type": "string" }
      },
      "additionalProperties": false
    },
    "lifecycle": { "type": "object", "additionalProperties": { "type": "string" } },
    "display": { "type": "object", "additionalProperties": true },
    "provenanceRefs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
