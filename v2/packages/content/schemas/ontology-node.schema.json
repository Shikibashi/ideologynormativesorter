{
  "$id": "https://example.com/v2/ontology-node.schema.json",
  "type": "object",
  "required": ["id", "label"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "nodeScope": { "enum": ["primary", "specialist", "modifier", "context", "retired", "internal"] },
    "parentId": { "type": "string", "minLength": 1 },
    "canonicalDefinition": { "type": "string" },
    "boundaryStatement": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "family": { "type": "string" },
    "subfamily": { "type": "string" },
    "legacyDisposition": { "type": "string" },
    "conceptualStatus": { "type": "string" },
    "measurementStatus": { "type": "string" },
    "publicRoleStatus": { "type": "string" },
    "weight": { "type": "number" },
    "metadata": { "type": "object", "additionalProperties": true },
    "provenanceRefs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
